# ── Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # yalnız sunucu, asla NEXT_PUBLIC_ yapmayın
# Transaction pooler (port 6543) — uygulama çalışırken
DATABASE_URL=postgresql://postgres.xxxxxxxx:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=uzun-rastgele-bir-deger

# ── Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@bilardogo.com

# ── E-posta (opsiyonel, Resend)
RESEND_API_KEY=
EMAIL_FROM="BilardoGo <bildirim@bilardogo.com>"
