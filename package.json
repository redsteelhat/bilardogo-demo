{
  "name": "bilardogo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@bilardogo/web",
    "dev:admin": "turbo run dev --filter=@bilardogo/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @bilardogo/db generate",
    "db:migrate": "pnpm --filter @bilardogo/db migrate",
    "db:seed": "pnpm --filter @bilardogo/db seed",
    "db:seed:demo": "pnpm --filter @bilardogo/db seed:demo",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.5",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp", "@tailwindcss/oxide", "unrs-resolver"]
  }
}
